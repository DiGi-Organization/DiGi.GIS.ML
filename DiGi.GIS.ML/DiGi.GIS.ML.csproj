<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The workspace-standard output layout: every DiGi library resolves as ..\..\<Repo>\bin\<Assembly>.dll.
         Without these three a consumer has to name a configuration and a target framework in its HintPath, which
         then links the Release binary from a Debug build and resolves to nothing at all on a workspace that has
         only ever been built Debug. -->
    <OutputPath>..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.LightGbm" Version="5.0.0" />
    <!-- DiGi.GIS.IO's streaming readers for the open building datasets (DiGi.GIS.IO#17): DiGi.GIS.IO is
         referenced by HintPath, so its NuGet dependencies never reach this host from NuGet, and the
         Sqlite provider would only fail at its native e_sqlite3 on the first read. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoPackage" Version="2.0.0" />
    <PackageReference Include="Parquet.Net" Version="5.5.0" />
    <!-- Pin above the version Parquet.Net 5.5.0 resolves to (GHSA-pggp-6c3x-2xmx, NU1903). -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <!-- Pin above the version Microsoft.Data.Sqlite 10.0.5 resolves to (GHSA-2m69-gcr7-jv3q, NU1903). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <!-- Microsoft.ML pins this at 9.0.4 while DiGi.GIS.IO and Parquet.Net need 10.0.0.9; the direct
         reference makes 10.0.9 primary and removes the MSB3277 version conflict. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup Label="OrtoBuildingDetectionModel">
    <None Include="OrtoBuildingDetectionModel.mlnet">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="DiGi.Core">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.IO">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS">
      <HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.IO">
      <HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Unit">
      <HintPath>..\..\DiGi.Unit\bin\DiGi.Unit.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Unit.IO">
      <HintPath>..\..\DiGi.Unit\bin\DiGi.Unit.IO.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>